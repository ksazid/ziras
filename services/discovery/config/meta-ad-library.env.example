# Ziras Meta Ad Library integration
# Keep disabled until every readiness dependency below is complete.
META_AD_LIBRARY_ENABLED=false

# Meta account / authorization prerequisites
META_AD_LIBRARY_IDENTITY_LOCATION_VERIFIED=false
META_AD_LIBRARY_DEVELOPER_ACCOUNT_READY=false
META_AD_LIBRARY_PLATFORM_POLICY_ACCEPTED=false
META_AD_LIBRARY_APP_ID=
META_AD_LIBRARY_API_ACCESS_CONFIRMED=false

# Secret: configure only in deployment secret storage; never commit a real token.
META_AD_LIBRARY_ACCESS_TOKEN=

# Required runtime version. Pin the currently supported Meta Graph API version at deployment time.
META_GRAPH_API_VERSION=

# Ziras governance gate. Set true only after the source policy has been reviewed/approved.
META_AD_LIBRARY_SOURCE_POLICY_APPROVED=false

# Malta-first defaults. Comma-separated values.
META_AD_LIBRARY_COUNTRIES=MT
META_AD_LIBRARY_PLATFORMS=FACEBOOK,INSTAGRAM
META_AD_LIBRARY_ACTIVE_STATUS=ACTIVE
META_AD_LIBRARY_AD_TYPE=ALL
